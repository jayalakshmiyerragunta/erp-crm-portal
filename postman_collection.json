{
  "info": {
    "name": "ERP + CRM Portal API",
    "description": "Full API collection for the Mini ERP + CRM Operations Portal.\n\n· base_url points at the LIVE backend by default.\n· Switch to local development by setting base_url = http://localhost:5001/api/v1 (and base_url_root = http://localhost:5001).\n· Each Login request saves the JWT into the token variable — every other request sends Authorization: Bearer {{token}} automatically.\n· List endpoints support ?page=&limit=&search= and domain-specific filters.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://erp-crm-backend-u5a0.onrender.com/api/v1",
      "type": "string"
    },
    {
      "key": "base_url_root",
      "value": "https://erp-crm-backend-u5a0.onrender.com",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "REPLACE_WITH_USER_ID",
      "type": "string"
    },
    {
      "key": "customer_id",
      "value": "REPLACE_WITH_CUSTOMER_ID",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "REPLACE_WITH_PRODUCT_ID",
      "type": "string"
    },
    {
      "key": "challan_id",
