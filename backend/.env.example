# Server
PORT=5000
NODE_ENV=development

# Database
# Local dev via docker-compose: postgresql://postgres:password@localhost:5432/erp_crm_db
# Production (deployed): use your Neon / managed Postgres connection string, e.g.
#   postgresql://user:pass@ep-xxx.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/erp_crm_db"

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS — set to your frontend origin in production, e.g. https://erp-crm-portal-idok.vercel.app
# CORS_ORIGIN=https://your-frontend-domain
